# App
PROJECT_NAME="Fashion Marketplace"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="fashion-marketplace-super-secret-production-key-change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
# Default to SQLite for easy local development, or PostgreSQL for production:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/fashion_marketplace"
DATABASE_URL="sqlite+aiosqlite:///./fashion_marketplace.db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://127.0.0.1:3000","http://127.0.0.1:3001","http://127.0.0.1:3002"]

# Storage / Media
MEDIA_ROOT="./media"
UPLOAD_MAX_SIZE_MB=10

# Security / Rate Limiting
RATE_LIMIT_PER_MINUTE=120
BCRYPT_ROUNDS=12

# External Services Mocking
MOCK_PAYMENT_GATEWAY=true
MOCK_COURIER_SERVICE=true
